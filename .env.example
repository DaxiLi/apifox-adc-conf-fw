# ADC 连接配置 —— 复制为 .env 后填写（.env 已被 .gitignore 排除，勿提交）
# 用法：Windows:  copy .env.example .env  ｜ Linux/macOS:  cp .env.example .env

# 后端类型：apisix（本仓库）| api7ee | apisix-standalone
ADC_BACKEND=apisix

# Admin API 地址（默认 http://localhost:9180）
ADC_SERVER=http://localhost:9180

# Admin API 密钥（对应网关 config.yaml 的 deployment.admin.admin_key[].key）
ADC_TOKEN=请替换为你的Admin-API-Key

# 可选：Admin API 走 HTTPS 时
# ADC_CA_CERT_FILE=证书路径
# ADC_TLS_SKIP_VERIFY=false
